# GitHub Container Registry image coordinates.
GHCR_OWNER=edencirakoglu
GHCR_REPOSITORY=client-tracker
IMAGE_TAG=replace_with_verified_commit_sha
HTTP_BIND=127.0.0.1
HTTP_PORT=80

# PostgreSQL credentials. Use unique production values.
POSTGRES_USER=clientops
POSTGRES_PASSWORD=replace_with_a_long_random_database_password
POSTGRES_DB=clientops_tracker
DATABASE_URL=postgresql://clientops:replace_with_a_long_random_database_password@postgres:5432/clientops_tracker

# API security and browser access. With Nginx, the browser and API share one origin.
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters
CORS_ORIGIN=https://app.example.com

# Same-origin requests through Nginx; reusable images do not contain a fixed host.
# An absolute external API origin still requires a rebuild if changed.
NEXT_PUBLIC_API_URL=/
