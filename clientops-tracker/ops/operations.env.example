# Install as /etc/clientops/operations.env, root-owned mode 600, not in Git.
APP_DIR=/opt/client-tracker/clientops-tracker
COMPOSE_PROJECT_NAME=clientops-production
ENV_FILE=/etc/clientops/production.env
TLS_CERTS_DIR=/etc/clientops/tls
# Add the following to the private Compose ENV_FILE alongside production variables:
# RESTIC_REPOSITORY=s3:https://region.digitaloceanspaces.com/dedicated-private-backup-bucket/clientops
# BACKUP_ACCESS_KEY_ID=<bucket-only credential>
# BACKUP_SECRET_ACCESS_KEY=<bucket-only secret>
# OPS_SECRETS_DIR=/etc/clientops/backup-secrets
# /etc/clientops/backup-secrets/restic-password: unique random passphrase, escrow separately.
# /etc/clientops/backup-secrets/alert-curl.conf: url = "https://operator-webhook-endpoint"
# Add auth to that curl config as needed. Do not put tokens in source control.
