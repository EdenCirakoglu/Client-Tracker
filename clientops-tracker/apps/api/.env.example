NODE_ENV=development
PORT=8080
DATABASE_URL=postgresql://clientops:clientops_dev_password@localhost:5432/clientops_demo
# Only this explicitly designated disposable database may be reset.
DISPOSABLE_DATABASE_NAME=clientops_demo
# Set SEED_RESET=true in the shell only when intentionally resetting the demo.
APP_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:8080
SESSION_SECRET=replace_this_with_a_long_random_session_secret_for_local_development
SESSION_IDLE_SECONDS=1800
SESSION_ABSOLUTE_SECONDS=28800
TRUST_PROXY=0
# Enable only for the explicitly designated disposable database above.
DEMO_MODE=true
SMTP_MODE=capture
SMTP_HOST=localhost
SMTP_PORT=11025
MAIL_FROM=clientops@example.com
