{
  "name": "clientops-tracker",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --stream dev",
    "dev:api": "pnpm --filter @clientops/api dev",
    "dev:web": "pnpm --filter @clientops/web dev",
    "build": "pnpm -r --if-present build",
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present typecheck && tsc -p tsconfig.e2e.json --noEmit",
    "test": "pnpm -r --if-present test",
    "test:e2e": "playwright test",
    "format": "prettier --write . ../README.md ../CONTRIBUTING.md ../SECURITY.md ../.github",
    "format:check": "prettier --check . ../README.md ../CONTRIBUTING.md ../SECURITY.md ../.github",
    "db:up": "docker compose up -d postgres",
    "db:test:up": "docker compose -p clientops-hardening-tests -f docker-compose.hardening-test.yml up -d --wait",
    "db:test:down": "docker compose -p clientops-hardening-tests -f docker-compose.hardening-test.yml down",
    "verify:stack": "node scripts/hardening-stack.mjs start",
    "verify:stop": "node scripts/hardening-stack.mjs stop",
    "auth:bootstrap": "pnpm --filter @clientops/api auth:bootstrap",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @clientops/api db:generate",
    "db:migrate": "pnpm --filter @clientops/api db:migrate",
    "db:seed": "pnpm --filter @clientops/api db:seed",
    "db:studio": "pnpm --filter @clientops/api db:studio"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.18.0",
    "@next/eslint-plugin-next": "^15.1.4",
    "@playwright/test": "^1.63.0",
    "@types/node": "22.10.7",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.20.0"
  }
}
